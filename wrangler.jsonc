{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ict-ops-board",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD_HUB", "class_name": "BoardHub" },
      { "name": "BOARD_STATS", "class_name": "BoardStats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardHub", "BoardStats"] }
  ],
  "routes": [{ "pattern": "ict.nerv-base.com", "custom_domain": true }],
  "vars": {
    "CONTEST_SLUG": "ictcompetition",
    "CONTEST_ID": "6a9e2d04bf41025d60f21804"
  }
}
